# Faz o `engines` de package.json valer de verdade.
# Sem isso o npm só emite aviso e instala em Node fora da faixa, quebrando em
# runtime com mensagens obscuras (ERR_UNKNOWN_FILE_EXTENSION, sintaxe TS).
# Verificado: instala normalmente em Node compatível e recusa em incompatible.
engine-strict=true
