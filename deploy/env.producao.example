# =============================================================================
# lola_site — exemplo de `.env` para PRODUÇÃO (comum aos serviços)
# =============================================================================
# Copie para o servidor e edite (NUNCA edite dentro do git):
#
#   install -m 600 deploy/env.producao.example /srv/lola/.env
#   $EDITOR /srv/lola/.env
#
# e o arquivo de segredos do servidor de dados:
#
#   install -m 600 deploy/env.producao.dados.example /srv/lola/.env.dados
#   $EDITOR /srv/lola/.env.dados
#
# Por que 600 e fora do projeto: qualquer processo do usuário consegue ler
# arquivos dele; o 600 limita a leitura ao root e a quem sobe o compose. Fora
# do projeto, o `.env` não entra em cópia de código, em preview de editor nem
# em imagem Docker.
#
# O compose injeta estas variáveis com `env_file` (não `environment:`), então
# trocar um valor exige `docker compose up -d` — o `restart` não relê o arquivo.
#
# Regra dos dois arquivos (é o coração do modo dividido):
#   .env        o que os DOIS serviços podem ver (inclui LOLA_INTERNAL_SECRET)
#   .env.dados  só o data-server (chave AES dos pedidos + chave do painel)
# =============================================================================


# -----------------------------------------------------------------------------
# Segredos comuns
# -----------------------------------------------------------------------------

# O que trocar: sim. É o segredo do canal interno vitrine <-> data-server
# (assinatura HMAC de cada chamada, com nãoces anti-replay). As DUAS partes
# precisam do MESMO valor — por isso ele mora no `.env` comum, e não em
# `.env.dados`. Gere com: openssl rand -hex 32
# Por que não é a chave dos pedidos: ela protege a PASSAGEM, não o conteúdo —
# cada arquivo cifrado tem sua própria chave, que fica em `.env.dados`.
LOLA_INTERNAL_SECRET=

# O que trocar: sim, o e-mail do dono. Usado pelo Caddy para avisos de
# certificado Let's Encrypt.
SITE_OWNER_EMAIL=loja@example.com

# O que trocar: a URL pública da loja (protocolo + domínio, sem barra no fim).
# Ex.: https://www.example.com
# Por que: vira a URL canônica (sitemap.xml e os redirects de /sitemap.xml) e
# o valor que o Caddy usa no `{$LOLA_SITE_HOST}. Sem domínio não há TLS
# confiável, e sem TLS o navegador marca o site como "Não seguro".
APP_URL=

# O que trocar: o token do Gemini, se você tiver conta própria (recomendado).
# O que ele faz: a API recebe o texto do formulário de orçamento + o nome do
# produto e devolve a resposta do cliente em JSON.
# Por que é seguro assim: o token é lido SÓ pelo servidor (rota
# /api/proxy/orcamento) e vai para o Gemini de servidor-para-servidor — o
# navegador nunca o vê. Sem token, o formulário responde "Serviço de orçamento
# indisponível (503)" e o resto da loja segue funcionando.
# O que a IA enxerga: o texto digitado, o nome do produto e o que o cliente
# escrever na conversa — nunca a planilha, os pedidos nem o painel.
GEMINI_API_KEY=

# O que trocar: só se você tiver conta própria. Mesma regra do Gemini: a API
# Key fica no servidor e o navegador fala com /api/proxy/geocode no SEU
# domínio, que faz o fetch com a Authorization do servidor.
GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# Rate limit (teto que protege a loja de esgotamento e a conta de IA)
# -----------------------------------------------------------------------------

# Por que estes valores: 600/min por IP é o orçamento bruto da API, aplicado
# ANTES do leitor de corpo — sem ele, JSON malformado (400) ou corpo acima de
# 16 kB (413) não consumiam bucket nenhum e podiam ser disparados sem teto.
LOLA_API_BUDGET_PER_MINUTE=600

# Por que 300/hora e 1000/dia: bem acima do volume real de uma loja pequena,
# e ao mesmo tempo um teto contra esgotamento de estoque (segurar reserva é
# de graça e o produto só volta para a vitrine quando a janela vence).
# Rode o deploy/rotate-orders-key.ts todo ano, antes de chegar perto de 80%
# destes números (o arquivo de pedidos tem teto de 10.000 registros).
ORDERS_RATE_LIMIT_MAX=300
ORDERS_RATE_LIMIT_WINDOW_MS=3600000
ORDERS_DAILY_LIMIT_MAX=1000
ORDERS_DAILY_LIMIT_WINDOW_MS=21600000

# Por que 600/hora: cada consulta do assistente virtual é uma chamada paga do
# Gemini. Se a fatura subir, baixe este número — a IA degrada para o motor
# local de regras, sem derrubar o formulário.
LOLA_AI_PER_HOUR=600

# Por que 20 s: acima disso o formulário cai no motor local de regras em vez
# de deixar o cliente esperando. É um teto de paciência, não de segurança.
LOLA_AI_TIMEOUT_MS=20000


# -----------------------------------------------------------------------------
# Comportamento do processo
# -----------------------------------------------------------------------------

# Por que false: em produção o front-end serve apenas dist/ e responde 404 em
# qualquer caminho fora da lista de estáticos (ver server.ts, servePublicSite).
# Nunca deixe "dev": em dev ele serve o código-fonte como arquivos estáticos.
SERVE_SOURCE=false

# Por que vazio (default) em Docker: dentro do container o caminho padrão já é
# /app/.data, e é esse diretório que o volume nomeado `lola-data` cobre.
# Apontar para /srv/lola/.data (caminho do HOST) não funciona: o container não
# enxerga o filesystem do host. Quem precisa do caminho do host é o BACKUP, e
# lá o caminho certo é `LOLA_COMPOSE_SERVICE=data-server` (o backup.sh copia
# com `docker compose cp` em vez de ler o disco do host).
LOLA_DATA_DIR=

# Por que true: HSTS protege o navegador; ignorar cabeçalho vindo por HTTP
# simples torna o padrão inofensivo.
LOLA_HSTS_ENABLED=true

# Por que false: ligar arrastaria TODOS os subdomínios para HTTPS — incluindo
# pedidos.example.com, que precisa existir e estar em TLS antes de você ligar
# isto. Se ligar com o subdomínio fora do ar, ele fica inacessível pelos
# 180 dias do max-age.
LOLA_HSTS_INCLUDE_SUBDOMAINS=false

# Por que mask: IP endereçável é dado pessoal (LGPD). "mask" mantém a rede e
# apaga o host (189.45.x.x) — o suficiente para investigar abuso sem gravar
# endereço completo em log. Use "full" só por investigação pontual e curta.
LOLA_LOG_IP_MODE=mask

# O que trocar: sim, se usar o modo `hash` acima. Sem esta chave, o token sai
# de um salto fixo e qualquer um reproduz a mesma sequência. Gere com
# openssl rand -hex 32.
LOLA_LOG_IP_SECRET=


# -----------------------------------------------------------------------------
# PROXY REVERSO (Caddy/nginx na frente da vitrine)
# -----------------------------------------------------------------------------

# O que trocar: deixe exatamente assim (dois IPs, separados por vírgula).
# Por que: 172.31.0.1 é a ponte da rede `lola-publica` (onde o proxy está na
# máquina) e 127.0.0.1 é o loopback do host, para você falar com o data-server
# por SSH tunnel. Sem isto, todo cliente aparece com o IP do proxy e divide o
# mesmo bucket de rate limit — um atacante derruba o checkout de todo mundo.
# E nunca use "true": o Express passaria a acreditar em qualquer
# X-Forwarded-For que o navegador mandar.
LOLA_TRUSTED_PROXY=127.0.0.1,172.31.0.1

# -----------------------------------------------------------------------------
# MODO EMBUTIDO (perfil `embutido` — um único container)
# -----------------------------------------------------------------------------
# Estas duas só valem quando você roda com o perfil `embutido`; no modo
# dividido o compose as ignora de propósito (o painel vive no data-server).

# O que trocar: a chave AES dos pré-pedidos, só no modo embutido.
# Gere com: openssl rand -hex 32 — e guarde a MESMA chave no cofre de senhas.
# Por que ela NÃO pode estar aqui no modo dividido: quem lê este arquivo é a
# vitrine, que é o container exposto no proxy. A chave de cifra do pedido é o
# alvo mais valioso da máquina; no modo dividido ela mora em `.env.dados`,
# que só o data-server lê.
# Em desenvolvimento, sem esta chave, a aplicação grava a chave AO LADO do
# ciphertext (.data/orders.key) — aceitável em dev, jamais em produção.
LOLA_ORDERS_ENCRYPTION_KEY=

# O que trocar: a chave da API administrativa, mínimo 32 caracteres.
# Gere com: openssl rand -hex 32.
# Em modo dividido esta chave vive SÓ no `.env.dados` — é esse o ganho da
# separação: o servidor público não a carrega.
LOLA_ADMIN_API_KEY=

# Por que true (só no modo embutido E com proxy): a lista branca de /admin
# lê o IP do socket da conexão. Atrás do Caddy/nginx, TODO chamador aparece
# com o IP do proxy — e o painel bloquearia o próprio dono (403). Com este
# opt-in, o Express aceita o X-Forwarded-For vindo do proxy declarado.
# No modo dividido deixe false: o painel não fica na vitrine.
LOLA_ADMIN_ALLOW_PRIVATE_PROXY=true

# Por que true (só no modo embutido): em produção o painel não é montado sem
# este opt-in explícito — quem comprometer o processo público não encontra
# rota de administração nenhuma, mesmo com a chave correta na mão.
# No modo dividido esta variável é ignorada: o painel vive no data-server.
LOLA_EMBEDDED_ADMIN=true
