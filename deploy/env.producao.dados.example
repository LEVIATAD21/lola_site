# =============================================================================
# lola_site — exemplo de `.env.dados` para PRODUÇÃO
# =============================================================================
# Copie para o servidor e edite:
#
#   install -m 600 deploy/env.producao.dados.example /srv/lola/.env.dados
#   $EDITOR /srv/lola/.env.dados
#
# O que é este arquivo: o conjunto de segredos que SÓ o container `data-server`
# recebe (no compose: env_file com `required: false`, para não travar o perfil
# `embutido`, que não o usa).
#
# Por que separar do `.env` comum: no modo dividido, a vitrine é o container
# exposto no proxy — o alvo preferencial de um invasor. Se a chave de cifra dos
# pedidos e a chave do painel estiverem no mesmo arquivo que a vitrine lê, a
# separação de superfície (o ganho inteiro do modo dividido) deixa de existir.
# Este arquivo entra no container do data-server, que fica só numa rede
# `internal: true`, sem porta publicada e sem rota para a internet.
#
# Gere os valores com:
#   openssl rand -hex 32
# =============================================================================

# O que trocar: OBRIGATÓRIO. É a chave AES-256-GCM que cifra os pré-pedidos
# (nome, telefone, endereço — PII de cliente). Sem ela o data-server de produção
# falha na inicialização; ele não anuncia saúde nem aceita tráfego sem cifragem.
# Guarda desta chave: cofre de senhas do dono (Bitwarden/1Password/LastPass) +
# cópia em papel no cofre físico. O deploy/backup.sh NÃO a inclui no tar.gz —
# se ela se perder, o backup inteiro vira lixo cifrado.
LOLA_ORDERS_ENCRYPTION_KEY=

# O que trocar: SIM, e é obrigatório. Chave da API administrativa, mínimo 32
# caracteres. É o que o `x-admin-key` valida nas rotas do painel.
# Por que aqui e não no `.env` comum: ela abre o histórico de pedidos. No modo
# dividido, o servidor público não deve carregá-la em nenhuma hipótese.
LOLA_ADMIN_API_KEY=

# Opcional. Lista de IPs/CIDRs de quem pode usar o painel (ex.:
# 203.0.113.7,10.0.0.9/32). Vazio = loopback + faixa privada (RFC1918).
# A leitura usa o IP do socket, nunca um header — origem não se forja.
# `any` é recusado em produção.
# Preencha só se o painel for acessado de fora do túnel SSH descrito em
# deploy/rotate-orders-key.md; na configuração recomendada, vazio já basta.
LOLA_ADMIN_ALLOWED_IPS=

# Por que vazio (default) em Docker: dentro do container o caminho padrão já é
# /app/.data, e é esse diretório que o volume nomeado `lola-data` cobre.
LOLA_DATA_DIR=

# TLS entre a vitrine e o data-server. O compose usa `LOLA_INTERNAL_PLAINTEXT=true`
# e `LOLA_PRIVATE_NETWORK_ISOLATED=true` nos dois containers SOMENTE porque a
# rede `lola-interna` é `internal: true`, tem IP RFC1918 fixo e não publica a
# porta 4100; o segredo HMAC continua obrigatório.
# HMAC autentica e protege integridade, mas NÃO cifra o conteúdo. Se separar as
# máquinas ou usar qualquer rede que não seja isolada e controlada, configure
# certificados aqui e mantenha o canal em HTTPS.
LOLA_TLS_CERT_FILE=
LOLA_TLS_KEY_FILE=

# Arquivo alternativo para a chave AES (em vez da variável acima). Use quando a
# chave vier de um secret do Docker/Kubernetes montado somente-leitura.
# A variável de ambiente, quando presente, tem precedência. O arquivo precisa de
# permissão 0600, senão os pré-pedidos ficam desligados.
# Atenção: o arquivo tem que ficar FORA de LOLA_DATA_DIR — senão o backup
# levaria ciphertext e chave juntos de volta.
LOLA_ORDERS_KEY_FILE=
