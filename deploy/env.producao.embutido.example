# Segredos exclusivos do modo embutido (um container só).
# Copie para .env.embutido SOMENTE ao usar --profile embutido.
# Nunca copie este arquivo para .env: o modo dividido entrega .env à vitrine.
#
# Em modo dividido, os segredos equivalentes vivem em .env.dados, carregado
# exclusivamente pelo data-server.
# -----------------------------------------------------------------------------
# MODO EMBUTIDO (perfil `embutido` — um único container)
# -----------------------------------------------------------------------------
# Todas as variáveis abaixo são carregadas somente pelo serviço `embutido`;
# os serviços `vitrine` e `data-server` do perfil dividido nunca leem este arquivo.

# O que trocar: a chave AES dos pré-pedidos, só no modo embutido.
# Gere com: openssl rand -hex 32 — e guarde a MESMA chave no cofre de senhas.
# Este arquivo é lido somente pelo container embutido. No modo dividido, a
# chave fica em `.env.dados`, que somente o data-server recebe; a vitrine nunca
# recebe a chave de cifra nem a chave administrativa.
# Em desenvolvimento, sem esta chave, a aplicação grava a chave AO LADO do
# ciphertext (.data/orders.key) — aceitável em dev, jamais em produção.
LOLA_ORDERS_ENCRYPTION_KEY=

# O que trocar: a chave da API administrativa, mínimo 32 caracteres.
# Gere com: openssl rand -hex 32.
# Em modo dividido esta chave vive SÓ no `.env.dados` — a vitrine não a carrega.
LOLA_ADMIN_API_KEY=

# Por que true (só no modo embutido E com proxy): a lista branca de /admin
# lê o IP do socket da conexão. Atrás do Caddy/nginx, TODO chamador aparece
# com o IP do proxy — e o painel bloquearia o próprio dono (403). Com este
# opt-in, o Express aceita o X-Forwarded-For vindo do proxy declarado.
# No modo dividido deixe false: o painel não fica na vitrine.
LOLA_ADMIN_ALLOW_PRIVATE_PROXY=true

# Por que true (só no modo embutido): em produção o painel não é montado sem
# este opt-in explícito — quem comprometer o processo público não encontra
# rota de administração nenhuma, mesmo com a chave correta na mão.
# No modo dividido esta variável é ignorada: o painel vive no data-server.
LOLA_EMBEDDED_ADMIN=true
