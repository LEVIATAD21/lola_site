# GEMINI_API_KEY: chave opcional para o assistente virtual do backend.
# Sem a chave, o assistente responde pelo motor de regras local.
GEMINI_API_KEY=""

# APP_URL: URL pública onde a aplicação será hospedada.
APP_URL=""

# Diretório persistente usado pelo estoque do servidor.
# Em produção, aponte para um volume/disco persistente fora do deploy.
LOLA_DATA_DIR="./.data"

# Chave AES-256-GCM (64 caracteres hexadecimais) para cifrar pré-pedidos em produção.
# Gere com: openssl rand -hex 32. Em produção, configure como segredo do ambiente.
# Em desenvolvimento local, uma chave com permissões restritas é criada em .data/orders.key.
# Atenção: em dev essa chave fica AO LADO do arquivo cifrado, então uma cópia de
# backup de .data/ leva ciphertext e chave juntos — só aceitável fora de produção.
LOLA_ORDERS_ENCRYPTION_KEY=""

# Alternativa à variável acima: caminho de um arquivo contendo a mesma chave
# (64 hexadecimais). Use para guardar a chave FORA de LOLA_DATA_DIR, num volume
# de segredo do Docker/Kubernetes montado somente-leitura.
# Em produção esse arquivo precisa de permissão 0600, senão os pré-pedidos
# ficam desligados. A variável de ambiente, quando presente, tem precedência.
LOLA_ORDERS_KEY_FILE=""

# Chave secreta da API administrativa, apenas no servidor (mínimo 32 caracteres).
# Gere com: openssl rand -hex 32. Use o header HTTP x-admin-key nas rotas administrativas, incluindo a baixa de estoque.
LOLA_ADMIN_API_KEY=""

# HSTS em produção. Ligado por padrão: navegadores ignoram o cabeçalho quando ele
# chega por HTTP simples, então o padrão só protege. Desligue com "false" apenas
# se o hostname ainda precisar atender por HTTP.
LOLA_HSTS_ENABLED="true"

# Arrasta subdomínios para o HTTPS. Só ligue se TODOS já estiverem em HTTPS:
# quebra subdomínio em HTTP pelo período inteiro do max-age (180 dias).
LOLA_HSTS_INCLUDE_SUBDOMAINS="false"

# Janela em milissegundos em que um pré-pedido segura o estoque (padrão 30 min).
# Ao vencer, as unidades voltam automaticamente para a vitrine.
# As reservas vivem em memória: reiniciar o processo libera as reservas ativas.
LOLA_RESERVATION_TTL_MS=""

# Proxy reverso confiável (NÃO use "true"). Ex.: 127.0.0.1,10.0.0.0/8
# Vazio = confiar apenas no IP do socket (recomendado se não houver proxy).
# Declare aqui quando houver balanceador/nginx na frente, senão todos os clientes
# compartilham o mesmo bucket de rate limit e um atacante derruba o checkout.
LOLA_TRUSTED_PROXY=""

# Limites do assistente virtual por IP. Vazio usa os padrões abaixo.
# Ajuste conforme o orçamento da conta Gemini: cada consulta é uma chamada paga.
LOLA_AI_PER_MINUTE=""   # padrão 20
LOLA_AI_PER_HOUR=""     # padrão 120
LOLA_AI_PER_DAY=""      # padrão 400
LOLA_AI_TIMEOUT_MS=""   # padrão 20000 — acima disso cai no motor local de regras

# Limite de consultas GET de catálogo por IP por minuto (padrão 300).
# Generoso de propósito: a vitrine legítima passa longe disso.
LOLA_READ_PER_MINUTE=""
