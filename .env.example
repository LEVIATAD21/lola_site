# GEMINI_API_KEY: chave opcional para o assistente virtual do backend.
# Sem a chave, o assistente responde pelo motor de regras local.
#
# LGPD, art. 39: com a chave setada, a PERGUNTA DA CLIENTE (texto livre, que
# pode conter dado pessoal digitado por ela) e o contexto do produto/sacola são
# enviados ao Google (Gemini API) — operador no exterior, contrato de adesão às
# Google Cloud Terms + Data Processing Addendum. Sem aviso na UI e sem
# consentimento explícito hoje: veja REPORT.md, item "Terceiros". Enquanto essa
# lacuna não for fechada, deixe a chave VAZIA em produção.
GEMINI_API_KEY=""

# APP_URL: URL pública onde a aplicação será hospedada.
APP_URL=""

# Diretório persistente usado pelo estoque do servidor.
# Em produção, aponte para um volume/disco persistente fora do deploy.
# Lido APENAS pelo processo que tem os dados: o `data-server.ts`, ou o `server.ts`
# em modo embutido. A vitrine em modo dividido não abre este diretório.
LOLA_DATA_DIR="./.data"

# Chave AES-256-GCM (64 caracteres hexadecimais) para cifrar pré-pedidos em produção.
# Gere com: openssl rand -hex 32. Em produção, configure como segredo do ambiente.
# Em desenvolvimento local, uma chave com permissões restritas é criada em .data/orders.key.
# Atenção: em dev essa chave fica AO LADO do arquivo cifrado, então uma cópia de
# backup de .data/ leva ciphertext e chave juntos — só aceitável fora de produção.
LOLA_ORDERS_ENCRYPTION_KEY=""

# Rastreamento de envio (`.data/tracking.enc.json`). Vazia, reutiliza a chave de
# pré-pedidos acima; em produção configure chave própria estável (openssl rand -hex 32).
# Em desenvolvimento local, uma chave restrita é criada em .data/tracking.key.
LOLA_TRACKING_ENCRYPTION_KEY=""

# Alternativa à variável acima: caminho de um arquivo contendo a mesma chave
# (64 hexadecimais). Use para guardar a chave FORA de LOLA_DATA_DIR, num volume
# de segredo do Docker/Kubernetes montado somente-leitura.
# Em produção esse arquivo precisa de permissão 0600, senão os pré-pedidos
# ficam desligados. A variável de ambiente, quando presente, tem precedência.
LOLA_ORDERS_KEY_FILE=""

# Chave secreta da API administrativa, apenas no servidor (mínimo 32 caracteres).
# Gere com: openssl rand -hex 32. Use o header HTTP x-admin-key nas rotas administrativas, incluindo a baixa de estoque.
# Em modo dividido esta chave vive SÓ no servidor de dados — é justamente esse o
# ganho da separação: o servidor público não a carrega.
LOLA_ADMIN_API_KEY=""

# Restrição de origem das rotas administrativas, no servidor de dados.
# Vazio (padrão) = loopback + faixa privada (RFC1918, link-local, ULA IPv6).
# Liste IPs/CIDRs do painel, ex.: 203.0.113.7,10.0.0.9/32. Entrada inválida cai
# para o padrão privado. `any` abre tudo — só com risco assumido e consciente.
# A leitura usa o endereço do socket, nunca um header: origem não se forja.
LOLA_ADMIN_ALLOWED_IPS=""

# A allow administrativa lê o IP do socket. Atrás de um balanceador na rede
# privada, TODOS os chamadores aparecem como IP privado e passam na faixa
# padrão — a allowlist vira decoração. Se LOLA_TRUSTED_PROXY estiver declarado,
# o painel administrativo em produção só é montado com isto em "true".
LOLA_ADMIN_ALLOW_PRIVATE_PROXY="false"

# HSTS em produção. Ligado por padrão: navegadores ignoram o cabeçalho quando ele
# chega por HTTP simples, então o padrão só protege. Desligue com "false" apenas
# se o hostname ainda precisar atender por HTTP.
LOLA_HSTS_ENABLED="true"

# Arrasta subdomínios para o HTTPS. Só ligue se TODOS já estiverem em HTTPS:
# quebra subdomínio em HTTP pelo período inteiro do max-age (180 dias).
LOLA_HSTS_INCLUDE_SUBDOMAINS="false"

# Janela em milissegundos em que um pré-pedido segura o estoque (padrão 30 min).
# Ao vencer, as unidades voltam automaticamente para a vitrine.
# As reservas vivem em memória: reiniciar o processo libera as reservas ativas.
LOLA_RESERVATION_TTL_MS=""

# Retenção dos pré-pedidos em DIAS (padrão 90). LGPD, art. 15, II: o dado
# pessoal deixa de ser tratado quando a finalidade termina — aqui, quando uma
# negociação deixou de fazer sentido. Vazio/inválido cai no padrão; a varredura
# roda na subida e de hora em hora, e apagar reescreve o arquivo com a chave
# vigente (nenhum outro registro fica ilegível).
# 0 desliga a expiração automática: é opt-in explícito e passa a valer "para
# sempre, até alguém girar o arquivo" — declare no ROPA por quê.
LOLA_ORDER_RETENTION_DAYS=""   # padrão 90 (0 desliga — desaconselhado)

# Teto de pré-reservas simultâneas. Sem limite, um IP anônimo segurava o
# catálogo inteiro em reserva por 30 min e renovava continuamente — de graça,
# sem e-mail, sem pagamento — e a loja aparecia esgotada para clientes reais.
LOLA_MAX_ACTIVE_HOLDS=""    # padrão 500 (0 desliga)
# Por origem. No `server.ts` a origem é a IP da cliente e o teto separa
# clientes de verdade. No `data-server.ts` a origem é sempre a vitrine, então o
# padrão lá é 0 (desligado) — habilitar derrubaria o checkout real.
LOLA_MAX_HOLDS_PER_ORIGIN=""

# Proxy reverso confiável (NÃO use "true"). Ex.: 127.0.0.1,10.0.0.0/8
# Vazio = confiar apenas no IP do socket (recomendado se não houver proxy).
# Declare aqui quando houver balanceador/nginx na frente, senão todos os clientes
# compartilham o mesmo bucket de rate limit e um atacante derruba o checkout.
LOLA_TRUSTED_PROXY=""

# Limites do assistente virtual por IP. Vazio usa os padrões abaixo.
# Ajuste conforme o orçamento da conta Gemini: cada consulta é uma chamada paga.
LOLA_AI_PER_MINUTE=""   # padrão 20
LOLA_AI_PER_HOUR=""     # padrão 120
LOLA_AI_PER_DAY=""      # padrão 400
LOLA_AI_TIMEOUT_MS=""   # padrão 20000 — acima disso cai no motor local de regras

# Limite de consultas GET de catálogo por IP por minuto (padrão 300).
# Generoso de propósito: a vitrine legítima passa longe disso.
LOLA_READ_PER_MINUTE=""


# =============================================================================
# MODO DIVIDIDO: SITE PÚBLICO + SERVIDOR DE DADOS
# =============================================================================
# O projeto roda em um dos dois modos, escolhido na largada e nunca por requisição:
#
#   embutido  - LOLA_DATA_SERVICE_URL vazio. O `server.ts` tem tudo: catálogo,
#               pré-pedidos e, se você pedir, o painel administrativo.
#
#   dividido  - LOLA_DATA_SERVICE_URL preenchido. O `server.ts` passa a ser só a
#               vitrine: lê catálogo/estoque pelo canal interno e encaminha o
#               pré-pedido, mas não abre LOLA_DATA_DIR, não guarda a chave AES
#               nem a LOLA_ADMIN_API_KEY. As rotas administrativas respondem 404
#               e o prefixo /internal também. Quem tem os dados é o processo
#               `data-server.ts` (npm run start:data), que por padrão só aceita
#               conexão de 127.0.0.1 e exige o canal HMAC assinado.
#
# Model mental: [Site público A] --leitura--> [Banco C] <--escrita-- [Admin B]
# O ganho de segurança é de superfície: a máquina exposta ao mundo deixa de
# carregar a chave de cifra do pedido e a chave do painel.

# URL do servidor de dados, ex.: http://127.0.0.1:4300 (ativa o modo dividido).
# Precisa usar https:// fora de loopback: o canal carrega dado pessoal de pedido.
# Faixa link-local (169.254.x.x, fe80::) é recusada: é onde ficam os metadata
# services de nuvem, e nenhum servidor de dados legítimo mora lá.
LOLA_DATA_SERVICE_URL=""

# Segredo compartilhado assinando o canal interno (mínimo 32 caracteres).
# Gere com: openssl rand -hex 32. As DUAS máquinas precisam do MESMO valor, mas
# nenhuma delas expõe esse valor publicamente. Sem ele o servidor de dados não
# sobe e a vitrine recusa o modo dividido.
LOLA_INTERNAL_SECRET=""

# Lado da vitrine: onde o servidor de dados mora e como chamá-lo.
LOLA_INTERNAL_TIMEOUT_MS=""   # padrão 3000 — mais que isso o checkout responde 503
LOLA_INTERNAL_PLAINTEXT="false"  # true só se a rede entre as máquinas for privada E http
LOLA_SNAPSHOT_TTL_MS=""      # padrão 5000 — cache do catálogo, para não martelar o vizinho
LOLA_SNAPSHOT_STALE_MS=""    # padrão 60000 — serve o cache velho se o vizinho cair

# Lado do servidor de dados: o que ele aceita do vizinho.
LOLA_INTERNAL_SKEW_MS=""      # padrão 30000 — janela em que a assinatura vale
LOLA_INTERNAL_MAX_NONCES=""   # padrão 200000 — teto de nãoces guardados (anti-replay)
LOLA_INTERNAL_PER_MINUTE=""   # padrão 10000 — chamadas internas por minuto

# Lado do servidor de dados: onde ele escuta.
# Padrão 127.0.0.1. Coloque atrás de rede privada ou VPN, nunca na internet.
LOLA_BIND_HOST="127.0.0.1"
# Em produção o bind coringa (0.0.0.0 / ::) é recusado a menos que isto seja true.
LOLA_ALLOW_WILDCARD_BIND="false"

# TLS no servidor de dados. Configure os DOIS juntos ou nenhum: um sem o outro
# o processo não sobe. Sem TLS, `x-admin-key` e o PII completo dos pedidos
# (nome, telefone, endereço) atravessam a rede em claro — o loopback da vitrine
# não precisa, qualquer outro destino sim.
LOLA_TLS_CERT_FILE=""
LOLA_TLS_KEY_FILE=""


# =============================================================================
# PRIVACIDADE DOS REGISTROS (LGPD)
# =============================================================================

# Como o IP aparece nos logs. IP endereçável é dado pessoal; o logger o grava em
# três eventos (requisição, acesso administrativo e pedido).
#   mask  (padrão) — mantém a rede, apaga o host: `189.45.x.x`
#   hash  — token HMAC de 12 hex, só agrupa com a chave na mão
#   full  — endereço inteiro, para investigação pontual
#   off   — remove o campo da linha
LOLA_LOG_IP_MODE="mask"

# Chave do modo `hash`. Em produção declare a sua: sem ela o token sai de um
# salto fixo e qualquer um consegue reproduzir a mesma sequência.
LOLA_LOG_IP_SECRET=""


# =============================================================================
# MODO EMBUTIDO
# =============================================================================

# Pré-pedidos por IP por minuto (padrão 10). Teto da reserva simultânea por IP.
# Sobe o valor só em teste: mascararia o rate limit se fosse padrão.
LOLA_ORDER_PER_MINUTE=""

# Orçamento bruto de requisições de API por IP por minuto (padrão 600),
# aplicado ANTES do leitor de corpo. Os limites por rota só correm depois do
# `express.json`, então JSON malformado (400) ou corpo acima de 16 kB (413) não
# consumiam bucket nenhum e podiam ser disparados sem teto.
LOLA_API_BUDGET_PER_MINUTE=""

# Em produção, o painel administrativo só é montado no `server.ts` se isto for
# "true". Quem ainda roda tudo num processo só precisa declarar. Sem o opt-in a
# superfície administrativa não existe — nem com a chave correta na mão.
# No modo dividido esta variável é ignorada: o painel vive no `data-server.ts`.
LOLA_EMBEDDED_ADMIN="false"
