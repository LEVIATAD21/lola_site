# GEMINI_API_KEY: chave opcional para o assistente virtual do backend.
# Sem a chave, o assistente responde pelo motor de regras local.
GEMINI_API_KEY=""

# APP_URL: URL pública onde a aplicação será hospedada.
APP_URL=""

# Diretório persistente usado pelo estoque do servidor.
# Em produção, aponte para um volume/disco persistente fora do deploy.
LOLA_DATA_DIR="./.data"

# Chave AES-256-GCM (64 caracteres hexadecimais) para cifrar pré-pedidos em produção.
# Gere com: openssl rand -hex 32. Em produção, configure como segredo do ambiente.
# Em desenvolvimento local, uma chave com permissões restritas é criada em .data/orders.key.
LOLA_ORDERS_ENCRYPTION_KEY=""

# Chave secreta da API administrativa, apenas no servidor (mínimo 32 caracteres).
# Gere com: openssl rand -hex 32. Use o header HTTP x-admin-key nos endpoints /api/admin/*.
LOLA_ADMIN_API_KEY=""
